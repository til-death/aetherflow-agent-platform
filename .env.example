DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME="AetherFlow Enterprise Agent Platform"
STACK_NAME=aetherflow-agent-platform
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"

SECRET_KEY=replace-with-a-long-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Docker Compose overrides this to db for backend containers.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-db-password

SENTRY_DSN=
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
TAG=latest

# Optional. Leave empty to use the deterministic rule Planner/Critic.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5.5
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_RETRIES=2
AGENT_STORE_RESPONSES=false
